# VexDB Active Memory - Environment Template
# Copy this file to .env and fill in your values.
# The application reads these variables at runtime.

# Database connection (PostgreSQL protocol, VexDB)
# Special characters in password must be URL-encoded (e.g. @ → %40)
VEXDB_APP_USER=vexdb
VEXDB_APP_PASSWORD=***
VEXDB_DSN=postgresql://vexdb:***@127.0.0.1:5432/vastbase
# You can also use indirection, for example:
# VEXDB_DSN=postgresql://vexdb:${VEXDB_APP_PASSWORD}@127.0.0.1:5432/vastbase

# Embedding provider: mock | dashscope | openai | openai-compatible | siliconflow | zhipuai
VEXDB_MEMORY_EMBEDDING_PROVIDER=mock
VEXDB_MEMORY_EMBEDDING_MODEL=text-embedding-v3
VEXDB_MEMORY_EMBEDDING_DIMENSIONS=1024
VEXDB_MEMORY_VECTOR_TYPE=floatvector

# Security & governance
VEXDB_MEMORY_PROMPT_GUARD=block
VEXDB_MEMORY_AUTO_RESOLVE_CONFLICTS=false
VEXDB_MEMORY_AUTO_RESOLVE_POLICY=manual
VEXDB_MEMORY_AUTO_LINK_DISTANCE=0.18
VEXDB_MEMORY_AUTO_LINK_LIMIT=5
VEXDB_MEMORY_REST_API_KEY=***

# For DashScope
# VEXDB_MEMORY_EMBEDDING_PROVIDER=dashscope
# VEXDB_MEMORY_EMBEDDING_MODEL=text-embedding-v3
# DASHSCOPE_API_KEY=***

# For OpenAI / OpenAI-compatible
# VEXDB_MEMORY_EMBEDDING_PROVIDER=openai
# VEXDB_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=***
# OPENAI_BASE_URL=https://api.openai.com/v1

# For SiliconFlow
# VEXDB_MEMORY_EMBEDDING_PROVIDER=siliconflow
# VEXDB_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_API_KEY=***
